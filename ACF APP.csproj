    <RootNamespace>ACF_APP</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

	  <ApplicationManifest>app.manifest</ApplicationManifest>
	  <ApplicationIcon>UI\Image\ACF_OR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
